<!--appenders are used to sending data to a particular destination - file, console, logstash-->
<configuration>
    <!--TCP Socket Appender - sends the logs over TCP to a target server (port 5000 in our case, where our logstash is taking input from)-->
    <appender name="logstash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>localhost:5000</destination>
        <!--encoder is used to transform the logs into json format-->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
<!--            <timeZone>UTC</timeZone>-->
        </encoder>
    </appender>

    <appender name = "myConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %n
            </pattern>
        </encoder>
    </appender>

    <appender name = "myFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!--log file name-->
        <file>
            logs/journalApp.log
        </file>
        <!--new file is created after is current file crosses 10MB, also keeps max 10 files in history-->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/journalApp-%d{yy-MM-dd_HH-mm}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %n
            </pattern>
        </encoder>
    </appender>

    <!--every log at INFO level or higher (INFO, WARN, ERROR) will be recorded-->
    <root level="INFO">
        <appender-ref ref="myConsoleAppender" />
        <appender-ref ref="myFileAppender" />
        <appender-ref ref="logstash" />
    </root>
</configuration>